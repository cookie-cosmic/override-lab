# Current-season data comes from the RobotEvents API and requires a personal token.
# events.vex.com -> Account -> API -> generate token. Copy this file to .env and paste it there.
# Never commit .env.
ROBOTEVENTS_TOKEN=

# ---- access architecture ---------------------------------------------------
# Platform owner. Both are required before owner sign-in is offered at all.
# Generate the authenticator secret with: npm run owner:totp
OWNER_ENTRY_CODE=
OWNER_TOTP_SECRET=

# Authorization window. Leave blank to use the season calendar resolved from RobotEvents.
# Never guess a season end date: an unset value simply means the season is still open.
SEASON_ENDS_AT=

# Optional. Set only when the API must accept requests from exactly one UI origin.
# CORS_ORIGIN=https://override-lab.web.app

# Optional web push. Without these the app schedules reminders locally and labels them as
# such; it never claims a push notification was delivered.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
