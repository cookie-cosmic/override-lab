# Current-season data comes from the RobotEvents API and requires a personal token.
# events.vex.com -> Account -> API -> generate token. Copy this file to .env and paste it there.
# Never commit .env.
ROBOTEVENTS_TOKEN=

# ---- access architecture ---------------------------------------------------
# Platform owner. The entry code is typed into the ordinary chapter access field on the
# homepage; when it matches, the owner console opens. Unset means owner sign-in stays closed.
# OWNER_TOTP_SECRET is optional: with it set, the entry code only starts verification and the
# authenticator code finishes it. Without it the entry code alone opens the console, limited by
# the server-side attempt budget (5 tries per 15 minutes per address).
# Generate the authenticator secret with: npm run owner:totp
# On a machine where these are not in the server's environment (a preview server started from a
# shell), `npm run owner:set` stores a hashed entry code in the local database instead.
OWNER_ENTRY_CODE=
OWNER_TOTP_SECRET=

# Authorization window. Leave blank to use the season calendar resolved from RobotEvents.
# Never guess a season end date: an unset value simply means the season is still open.
SEASON_ENDS_AT=

# Optional. Set only when the API must accept requests from exactly one UI origin.
# CORS_ORIGIN=https://override-lab.web.app

# Optional web push. Without these the app schedules reminders locally and labels them as
# such; it never claims a push notification was delivered.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
